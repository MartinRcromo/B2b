# Database Configuration (Supabase)
# Obtener de: https://app.supabase.com/project/_/settings/database
# Formato: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=${DATABASE_URL}
DB_HOST=${DB_HOST}
DB_PORT=${DB_PORT:-5432}
DB_NAME=${DB_NAME:-postgres}
DB_USERNAME=${DB_USERNAME:-postgres}
DB_PASSWORD=${DB_PASSWORD}

# Vendure Configuration
COOKIE_SECRET=${COOKIE_SECRET}
SUPERADMIN_USERNAME=${SUPERADMIN_USERNAME:-superadmin}
SUPERADMIN_PASSWORD=${SUPERADMIN_PASSWORD}

# API Configuration
PORT=${PORT:-3000}
SHOP_API_PATH=${SHOP_API_PATH:-/shop-api}
ADMIN_API_PATH=${ADMIN_API_PATH:-/admin-api}

# App URL (Railway auto-genera esta variable)
APP_URL=${RAILWAY_PUBLIC_DOMAIN:-http://localhost:3000}

# Node Environment
NODE_ENV=production

# Flexus ERP Integration
FLEXUS_API_URL=${FLEXUS_API_URL}
FLEXUS_API_KEY=${FLEXUS_API_KEY}

# AI Search Integration
OPENAI_API_KEY=${OPENAI_API_KEY}
CLAUDE_API_KEY=${CLAUDE_API_KEY}

# Email Configuration
EMAIL_TRANSPORT=${EMAIL_TRANSPORT:-file}
EMAIL_HOST=${EMAIL_HOST}
EMAIL_PORT=${EMAIL_PORT:-587}
EMAIL_USER=${EMAIL_USER}
EMAIL_PASSWORD=${EMAIL_PASSWORD}
