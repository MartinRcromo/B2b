    "@vendure/email-plugin": "^2.2.0",
    "pg": "^8.11.3",
    "better-sqlite3": "^9.4.3",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.11.19",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": "18.x"
  }
}
